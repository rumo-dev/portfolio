---
interface Props { leftImage: string; rightImage: string; altLeft?: string; altRight?: string; className?: string; }
const { leftImage, rightImage, altLeft = '適用前', altRight = '適用後', className = '' } = Astro.props;
const placeholder = /dummy|placeholder/i.test(leftImage + rightImage);
const base = import.meta.env.BASE_URL.replace(/\/$/, "") + "/";
---
<div class={'comparison ' + className}>
<img-comparison-slider tabindex="0" aria-label={altLeft + 'と' + altRight + 'の比較。左右矢印キーで操作できます。'}>
<img slot="first" src={placeholder ? base + 'media/placeholder-before.svg' : leftImage} alt={altLeft} loading="lazy" />
<img slot="second" src={placeholder ? base + 'media/placeholder-after.svg' : rightImage} alt={altRight} loading="lazy" />
</img-comparison-slider>
<div class="labels"><span>{altLeft}</span><span>{altRight}</span></div>
{placeholder && <p class="note">DUMMY IMAGE — 比較操作用の仮画像です。実機の描画結果ではありません。</p>}
</div>
<script>import 'img-comparison-slider';</script>
<style>
.comparison { margin: 1.5rem 0; } img-comparison-slider { display:block; width:100%; overflow:hidden; border-radius:12px; --divider-color:#f59e0b; --divider-width:2px; } img-comparison-slider:focus-visible { outline:3px solid var(--sl-color-accent); outline-offset:4px; } img { display:block; width:100%; height:auto; margin:0; } .labels { display:flex; justify-content:space-between; gap:1rem; font-size:.8rem; margin-top:.5rem; } .note { font-size:.75rem; color:var(--sl-color-text-muted); }
</style>