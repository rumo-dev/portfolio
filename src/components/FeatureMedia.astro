---
import ImgComparison from './ImgComparison.astro';
interface Props { title: string; caption?: string; beforeImage?: string; afterImage?: string; beforeLabel?: string; afterLabel?: string; }
const { title, caption = '同じカメラ・同じ露出で効果を比較するための画像枠です。', beforeLabel = '適用前', afterLabel = '適用後' } = Astro.props;
const { beforeImage, afterImage } = Astro.props;
const placeholder = !beforeImage || !afterImage || /dummy|placeholder/i.test(beforeImage + afterImage);
const base = import.meta.env.BASE_URL.replace(/\/$/, "") + "/";
const resolveImage = (src?: string) => !src ? undefined : (src.startsWith("/") ? base + src.slice(1) : src);
---
<figure class="feature-media not-content">
<div class="heading"><strong>{title}</strong>{placeholder && <span>仮画像 / 実機キャプチャへ差し替え予定</span>}</div>
<ImgComparison leftImage={resolveImage(beforeImage) ?? base + 'media/placeholder-before.svg'} rightImage={resolveImage(afterImage) ?? base + 'media/placeholder-after.svg'} altLeft={placeholder ? beforeLabel + '（仮画像）' : beforeLabel} altRight={placeholder ? afterLabel + '（仮画像）' : afterLabel} />
<figcaption>{caption}</figcaption>
</figure>
<style>.feature-media { margin:2rem 0; padding:1rem; border:1px solid var(--sl-color-hairline-light); border-radius:16px; background:var(--sl-color-bg-card); } .heading { display:flex; flex-wrap:wrap; justify-content:space-between; gap:.5rem; } .heading span,figcaption { font-size:.8rem; color:var(--sl-color-text-muted); } figcaption { line-height:1.8; }</style>
