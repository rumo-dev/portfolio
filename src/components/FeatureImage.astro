---
interface Props {
  title: string;
  src: string;
  alt: string;
  caption?: string;
}

const { title, src, alt, caption } = Astro.props;
const imageSrc = src.startsWith("/")
  ? import.meta.env.BASE_URL.replace(/\/$/, "") + src
  : src;
---

<figure class="feature-image not-content">
  <h3>{title}</h3>
  <img src={imageSrc} alt={alt} loading="lazy" />
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .feature-image {
    margin: 1.75rem 0;
    overflow: hidden;
    border: 1px solid var(--sl-color-hairline-light);
    border-radius: 16px;
    background: var(--sl-color-bg-card);
  }

  h3 {
    margin: 0;
    padding: 1rem 1.1rem 0.75rem;
    font-size: 1rem;
  }

  img {
    display: block;
    width: 100%;
    height: auto;
    background: #090b10;
  }

  figcaption {
    padding: 0.75rem 1.1rem 1rem;
    color: var(--sl-color-text-muted);
    font-size: 0.85rem;
    line-height: 1.7;
  }
</style>
