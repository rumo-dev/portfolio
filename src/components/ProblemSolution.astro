---
// 「課題 → 対応 → 結果」を1ブロックで示すコンポーネント
interface Props {
  problem: string; // 何が問題だったか
  steps: string[]; // どう対応したか
  result?: string; // 結果（数字があれば入れる）
}
const { problem, steps, result } = Astro.props;
---

<div class="ps-block not-content">
  <div class="psb-row">
    <p class="psb-label">課題</p>
    <p class="psb-text">{problem}</p>
  </div>
  <div class="psb-row">
    <p class="psb-label">対応</p>
    <ol class="psb-steps">
      {steps.map((s) => <li set:html={s} />)}
    </ol>
  </div>
  {
    result && (
      <div class="psb-row psb-result">
        <p class="psb-label">結果</p>
        <p class="psb-text">{result}</p>
      </div>
    )
  }
</div>

<style>
  .ps-block {
    margin: 1.2rem 0 1.5rem;
    border: 1px solid var(--sl-color-hairline-light);
    border-radius: 12px;
    background: var(--sl-color-bg-card);
    overflow: hidden;
  }
  .psb-row {
    display: grid;
    grid-template-columns: 4.5rem 1fr;
    gap: 1rem;
    padding: 1rem 1.3rem;
    border-bottom: 1px solid var(--sl-color-hairline);
  }
  .psb-row:last-child { border-bottom: none; }
  .psb-label {
    margin: 0;
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: var(--sl-color-accent);
  }
  .psb-text { margin: 0; color: var(--sl-color-text); line-height: 1.75; }
  .psb-steps {
    margin: 0;
    padding-left: 1.2rem;
    display: grid;
    gap: 0.5rem;
    line-height: 1.75;
    color: var(--sl-color-text);
  }
  .psb-result { background: rgba(245, 158, 11, 0.07); }
  .psb-result .psb-text { font-weight: 700; }
  @media (max-width: 560px) {
    .psb-row { grid-template-columns: 1fr; gap: 0.3rem; }
  }
</style>
