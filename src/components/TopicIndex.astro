---
// 技術解説のカテゴリ別一覧。src/data/topics.ts から自動生成します。
import { topics, categories, type CategoryKey } from "../data/topics";

interface Props {
  /** true なら「まずここから」だけを表示 */
  featuredOnly?: boolean;
}
const { featuredOnly = false } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const href = (slug: string) => `${base}/reference/${slug}/`;
const keys = Object.keys(categories) as CategoryKey[];
const featured = topics.filter((t) => t.featured);
---

{
  featuredOnly ? (
    <ul class="ti-featured not-content">
      {featured.map((t) => (
        <li>
          <a href={href(t.slug)}>
            <em>{categories[t.category].label}</em>
            <strong>{t.name}</strong>
            <span>{t.summary}</span>
          </a>
        </li>
      ))}
    </ul>
  ) : (
    <div class="ti-groups not-content">
      {keys.map((k) => {
        const items = topics.filter((t) => t.category === k);
        if (items.length === 0) return null;
        return (
          <section>
            <h3>
              {categories[k].label}
              <small>{categories[k].lead}</small>
            </h3>
            <ul>
              {items.map((t) => (
                <li>
                  <a href={href(t.slug)}>
                    <strong>{t.name}</strong>
                    <span>{t.summary}</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        );
      })}
    </div>
  )
}

<style>
  .ti-featured {
    margin: 1rem 0 2rem;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: 0.9rem;
  }
  .ti-featured a {
    display: grid;
    gap: 0.25rem;
    height: 100%;
    padding: 1rem 1.1rem;
    border: 1px solid var(--sl-color-hairline-light);
    border-top: 3px solid var(--sl-color-accent);
    border-radius: 10px;
    background: var(--sl-color-bg-card);
    text-decoration: none;
    color: var(--sl-color-text);
    transition: transform 0.2s, border-color 0.2s;
  }
  .ti-featured a:hover { transform: translateY(-2px); border-color: var(--sl-color-accent); }
  .ti-featured em { font-style: normal; font-size: 0.72rem; font-weight: 700; color: var(--sl-color-accent); letter-spacing: 0.05em; }
  .ti-featured strong { font-size: 1.02rem; }
  .ti-featured span { font-size: 0.85rem; line-height: 1.55; color: var(--sl-color-text-muted); }

  .ti-groups { display: grid; gap: 1.8rem; margin: 1rem 0 2rem; }
  .ti-groups h3 {
    margin: 0 0 0.7rem;
    font-size: 1.05rem;
    font-weight: 800;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.2rem 0.8rem;
  }
  .ti-groups h3 small { font-size: 0.8rem; font-weight: 400; color: var(--sl-color-text-muted); }
  .ti-groups ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 0.6rem;
  }
  .ti-groups a {
    display: grid;
    gap: 0.15rem;
    height: 100%;
    padding: 0.7rem 0.9rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 8px;
    text-decoration: none;
    color: var(--sl-color-text);
    transition: border-color 0.2s, background 0.2s;
  }
  .ti-groups a:hover { border-color: var(--sl-color-accent); background: var(--sl-color-bg-card); }
  .ti-groups strong { font-size: 0.95rem; }
  .ti-groups span { font-size: 0.82rem; line-height: 1.5; color: var(--sl-color-text-muted); }
</style>
