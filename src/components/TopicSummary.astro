---
// 技術解説ページの冒頭に置く要点カード
import { topicBySlug, categories } from "../data/topics";

const slug = Astro.url.pathname.split("/").filter(Boolean).pop() ?? "";
const topic = topicBySlug(slug);
const route = (Astro.locals as any).starlightRoute;
const body: string = route?.entry?.body ?? "";
const hasCompare = /<ImgComparison|<FeatureMedia/.test(body);
const hasDiagram = /```mermaid/.test(body);
const hasVideo = /<ModalVideo/.test(body);

const mediaHeading = hasCompare
  ? "効果比較スライダー"
  : hasDiagram
    ? slug === "gbuffer"
      ? "g-bufferのデータ構成図"
      : "処理フロー図"
    : hasVideo
      ? "デモ映像"
      : undefined;
const jumps = [
  [hasCompare ? "比較を見る" : hasDiagram ? "図を見る" : "デモを見る", mediaHeading],
  ["設計の意図", "設計判断処理の流れ"],
  ["実装の要点", "実装のポイント"],
].filter(([, anchor]) => anchor) as [string, string][];
---

{
  topic && (
    <aside class="topic-summary not-content" aria-label="この解説の要点">
      <p class="ts-kicker">{categories[topic.category].label} <span>この記事の要点</span></p>
      <p class="ts-lead">{topic.summary}</p>
      <ul class="ts-points">
        {topic.points.map((p) => <li>{p}</li>)}
      </ul>
      {
        jumps.length > 0 && (
          <nav class="ts-jump" aria-label="記事内リンク">
            {jumps.map(([label, h]) => (
              <a href={`#${h}`}>{label} →</a>
            ))}
          </nav>
        )
      }
    </aside>
  )
}

<style>
  .topic-summary {
    margin: 0 0 2.4rem;
    padding: 1.25rem 1.4rem;
    border: 1px solid var(--sl-color-hairline-light);
    border-left: 4px solid var(--sl-color-accent);
    border-radius: 12px;
    background: var(--sl-color-bg-card);
    display: grid;
    gap: 0.65rem;
  }
  .ts-kicker {
    margin: 0;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--sl-color-accent);
  }
  .ts-kicker span { margin-left: 0.45rem; color: var(--sl-color-text-muted); font-weight: 500; letter-spacing: 0; }
  .ts-lead {
    margin: 0;
    max-width: 72ch;
    font-size: 1.04rem;
    font-weight: 700;
    line-height: 1.65;
    color: var(--sl-color-text);
  }
  .ts-points {
    margin: 0;
    padding-left: 1.2rem;
    display: grid;
    gap: 0.3rem;
    color: var(--sl-color-text);
    font-size: 0.92rem;
    line-height: 1.7;
  }
  .ts-jump {
    margin: 0.25rem 0 0;
    font-size: 0.85rem;
    color: var(--sl-color-text-muted);
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }
  .ts-jump a {
    display: inline-flex;
    align-items: center;
    padding: 0.35rem 0.7rem;
    border: 1px solid var(--sl-color-hairline-light);
    border-radius: 999px;
    background: var(--sl-color-bg);
    font-weight: 600;
    color: var(--sl-color-text);
    text-decoration: none;
  }
  .ts-jump a:hover { border-color: var(--sl-color-accent); color: var(--sl-color-accent); }
  .ts-jump a:focus-visible { outline: 2px solid var(--sl-color-accent); outline-offset: 2px; }
</style>
