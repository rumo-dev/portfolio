---
interface Props {
  images: string[];
  isComparison?: boolean;
}

const { images: allImages, isComparison = false } = Astro.props;
// 仮画像（dummy*）はそのまま公開しない。実画像に差し替えるまでは「準備中」表示にする
const images = allImages.filter((src) => !/dummy/i.test(src));
const isPlaceholder = images.length === 0;
---

{
  isPlaceholder && (
    <div class="img-pending not-content" role="note">
      <strong>デモ画像は準備中です</strong>
      <span>実装コードと解説は下記をご覧ください。</span>
    </div>
  )
}
<div class={`image-container ${isComparison ? 'grid-2' : 'grid-1'}`} hidden={isPlaceholder}>
  {
    images.map((src) => (
      <div class="image-wrapper">
        <img src={src} alt="" loading="lazy" />
      </div>
    ))
  }
</div>

<style>
.image-container {
  width: 100%;
  margin: 1.5rem 0;
}

.grid-1 {
  display: block;
}

.grid-2 {
  display: grid;

  grid-template-columns: repeat(2, minmax(0, 1fr));

  gap: 1rem;

  /* 高さを揃える */
  align-items: stretch;
}

.image-wrapper {
  margin: 0;
  padding: 0;

  /* ← これ重要 */
  line-height: 0;

  overflow: hidden;

  border-radius: 10px;
}

.image-wrapper img {
  display: block;

  width: 100%;
  height: auto;

  vertical-align: top;

  border-radius: inherit;

  background: #1a1a1a;
}

@media (max-width: 768px) {
  .grid-2 {
    grid-template-columns: 1fr;
  }
}
</style>
<style>
.img-pending {
  margin: 1.2rem 0;
  padding: 0.9rem 1.1rem;
  border: 1px dashed var(--sl-color-hairline-light);
  border-radius: 10px;
  background: var(--sl-color-bg-card);
  display: flex;
  flex-wrap: wrap;
  gap: 0.2rem 0.8rem;
  align-items: baseline;
  font-size: 0.9rem;
  color: var(--sl-color-text-muted);
}
.img-pending strong { color: var(--sl-color-text); }
</style>
